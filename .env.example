# .env.example

# --- Kafka ---
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC_INN=inn_parsing_tasks
KAFKA_GROUP_ID=inn_parsing_group

# --- Browser / Playwright ---
HEADLESS=true
DEFAULT_TIMEOUT_MS=15000

# --- База данных ---
# ВАЖНО: host = db (это имя сервиса в docker-compose), порт 5432
DATABASE_URL=postgresql+asyncpg://postgres:postgres@db:5432/inn_db